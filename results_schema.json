{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HP ZGX Nano Benchmark Result Schema",
  "type": "object",
  "required": [
    "timestamp",
    "model",
    "version",
    "params",
    "quantization",
    "runtime",
    "runtime_version",
    "context_len",
    "batch_size",
    "ttft_ms",
    "inter_token_ms",
    "tokens_per_sec",
    "peak_mem_gb",
    "avg_watts",
    "ambient_c",
    "notes"
  ],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time", "description": "ISO 8601 timestamp of run completion" },
    "model": { "type": "string", "description": "Model family name (e.g., Llama-3.1, Qwen2.5)" },
    "version": { "type": "string", "description": "Exact HuggingFace tag or model revision" },
    "params": { "type": "string", "description": "Parameter count string (e.g., 8B, 32B, 70B)" },
    "quantization": { "type": "string", "description": "BF16, FP16, Q8_0, Q4_K_M, etc." },
    "runtime": { "type": "string", "description": "llama.cpp, ollama, pytorch, vllm" },
    "runtime_version": { "type": "string", "description": "Exact version or commit hash of the runtime" },
    "context_len": { "type": "integer", "description": "Context window length in tokens (1024, 4096, 16384, 65536, 131072)" },
    "batch_size": { "type": "integer", "description": "Number of concurrent requests (1, 2, 4, 8, 16)" },
    "ttft_ms": { "type": "number", "description": "Time to First Token (prefill latency) in milliseconds" },
    "inter_token_ms": { "type": "number", "description": "Average inter-token decode latency in milliseconds" },
    "tokens_per_sec": { "type": "number", "description": "Decode throughput (tokens / second)" },
    "peak_mem_gb": { "type": "number", "description": "Peak resident VRAM/RAM allocation in GB" },
    "avg_watts": { "type": "number", "description": "Average wall power draw in Watts" },
    "ambient_c": { "type": "number", "description": "Ambient room temperature in Celsius" },
    "notes": { "type": "string", "description": "Thermal, power, or operational anomalies" }
  }
}
