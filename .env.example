# Copy to .env and fill in your own values. .env is not committed.
# aws/setup.sh reads these; nothing else in the repo contains an account ID.
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-west-2
# S3 bucket names are global, so include something unique to you.
HP_BENCH_BUCKET=hp-bench-123456789012-usw2
